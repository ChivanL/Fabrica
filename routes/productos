import Router from 'express';
import {productosModel} from '../src/models/producto.ts';
import {productosController} from '../src/controllers/prod.ts';
export const productosRouter = Router.Router();

productosRouter.get("/productos", (productosController.getAll));
productosRouter.get("/productos/:id", (productosController.getById));
productosRouter.post("/productos", (productosController.create));
productosRouter.delete("/productos/:id", (productosController.delete));    
productosRouter.patch("/productos/:id", (productosController.update));    
